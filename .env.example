# Green Repository Configuration
# Copy this to .env and update values for your environment

# Server Settings
DEBUG=False
APP_NAME=Green Repository

# Database Configuration
# MySQL connection string
DATABASE_URL=mysql+mysqlconnector://root:password@localhost/green


# AI/ML Configuration
MODEL_PATH=./models/detector.pkl
CONFIDENCE_THRESHOLD=0.5

# IoT Settings
MAX_SENSOR_READINGS_PER_BATCH=100
SENSOR_DATA_RETENTION_DAYS=30

# API Settings
# CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
